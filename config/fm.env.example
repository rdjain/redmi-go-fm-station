# Copy to /data/debian/root/fm.env on the phone (inside the chroot: /root/fm.env), chmod 600. Never commit the real file.
# FM_TOKEN is generated by `fm-tuner.sh start` if missing; it is shown by `fm-tuner.sh token`.
FM_TOKEN=generated-on-first-start
FM_BIND=127.0.0.1
FM_PORT=8080
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=change-me-long-random-string
FM_MOUNT=/fm
# optional LAN listener (use `fm-lan.sh enable|disable` instead of editing by hand)
FM_LAN_LISTEN=0
FM_LAN_PORT=8081
FM_LAN_MAX=5
